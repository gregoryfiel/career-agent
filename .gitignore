# ─── Personal data — never commit ──────────────────────────────────────────
profile/*
!profile/_example/
!profile/.gitkeep

applications/
output/
*.pdf
*.docx

# CVs generated while testing the template — never commit a real one
CV_*.docx
CV_*.pdf
templates/cv/cv_*.js
!templates/cv/cv.example.js

# Inbox sweeps, transcripts, anything derived from private accounts
**/inbox-sweep-*.md
**/transcripts/
*.opus
*.m4a
*.mp3
*.wav

# ─── Toolchain ─────────────────────────────────────────────────────────────
node_modules/
__pycache__/
*.pyc
.venv/
venv/
.DS_Store
Thumbs.db
.env
.env.*
